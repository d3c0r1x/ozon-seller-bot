[TEMPLATE]
# Токен бота от @BotFather
OZON_SELLER_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram ID владельца магазина (узнать через @userinfobot)
ADMIN_IDS=123456789

# Ключи Seller API Ozon (https://seller.ozon.ru → Настройки → API-ключи).
# Если не задать — бот работает в демо-режиме с детерминированными данными.
OZON_CLIENT_ID=
OZON_API_KEY=

# Порог остатка для алертов
# DEFAULT_LOW_STOCK=10

# Час дневной сводки
# DIGEST_HOUR=9

# Часы проверок «товар закончился» (через запятую)
# STOCK_CHECK_HOURS=9,21
